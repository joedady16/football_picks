@page "/teams"
@rendermode InteractiveServer
@using NflPicks.Web.Services
@inject TeamStats Stats

<PageTitle>Teams</PageTitle>

<div class="d-flex align-items-end gap-3 mb-3">
    <h3 class="mb-0">Teams</h3>
    <div>
        <label class="form-label mb-0 small text-muted">Season</label>
        <input class="form-control form-control-sm" type="number" style="width:90px"
               @bind="seasonYear" @bind:after="Load" />
    </div>
</div>

@if (error is not null)
{
    <p style="color:#b00"><strong>Failed:</strong> @error</p>
}

@if (teams.Count > 0)
{
    <p class="text-muted small mb-3">
        Click a team for its game log, next opponent and how you've done picking them.
        Form is the last five results, newest on the right.
    </p>

    @foreach (var conf in new[] { "AFC", "NFC" })
    {
        <div class="row g-3 mb-3">
            @foreach (var div in new[] { "East", "North", "South", "West" })
            {
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card h-100">
                        <div class="card-header py-1 fw-semibold small">@conf @div</div>
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <tbody>
                                @foreach (var t in teams.Where(t => t.Conference == conf && t.Division == div)
                                                        .OrderByDescending(t => t.Wins - t.Losses)
                                                        .ThenByDescending(t => t.Margin))
                                {
                                    <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo(Link(t)))">
                                        <td>
                                            <a href="@Link(t)" class="fw-semibold text-decoration-none">@t.Abbr</a>
                                        </td>
                                        <td>@t.Record</td>
                                        <td class="small" style="color:@(t.Margin >= 0 ? "#2e7d32" : "#c62828")">
                                            @Signed(t.Margin)
                                        </td>
                                        <td class="text-end"><FormDots Results="@t.Last5" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }

    <p class="text-muted small">
        The middle number is average point margin per game.
    </p>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;
    [SupplyParameterFromQuery(Name = "season")] public int? Season { get; set; }

    private short seasonYear = (short)DateTime.Now.Year;
    private List<TeamStats.TeamSummary> teams = [];
    private string? error;

    private string Link(TeamStats.TeamSummary t) => $"teams/{t.Abbr}?season={seasonYear}";

    private static string Signed(decimal? v) =>
        v is null ? "—" : v > 0 ? $"+{v:0.0}" : $"{v:0.0}";

    protected override async Task OnInitializedAsync()
    {
        seasonYear = (short?)Season ?? await Stats.LatestSeasonAsync() ?? seasonYear;
        await Load();
    }

    private async Task Load()
    {
        error = null;
        try
        {
            teams = await Stats.SummariesAsync(seasonYear);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            teams = [];
        }
    }
}
