@page "/dbcheck"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Npgsql
@using NflPicks.Web.Data
@inject NpgsqlDataSource DataSource
@inject IDbContextFactory<PicksDbContext> DbFactory

<PageTitle>DB check</PageTitle>

<h3>Database connection</h3>

<p>
    Checks both access paths against the same pool: raw Npgsql for the analysis
    views, EF Core for everything else.
</p>

<button class="btn btn-primary" @onclick="RunCheck" disabled="@busy">
    @(busy ? "Checking..." : "Run check")
</button>

@if (error is not null)
{
    <p style="color:#b00"><strong>Failed:</strong> @error</p>
}
else if (results is not null)
{
    <table class="table">
        <thead><tr><th>Path</th><th>Check</th><th>Value</th></tr></thead>
        <tbody>
            @foreach (var r in results)
            {
                <tr><td>@r.Path</td><td>@r.Label</td><td>@r.Value</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private record Row(string Path, string Label, string Value);

    private List<Row>? results;
    private string? error;
    private bool busy;

    private async Task RunCheck()
    {
        busy = true;
        error = null;
        results = null;

        try
        {
            var rows = new List<Row>();

            // ---- raw Npgsql: the path the analysis views will use ----
            await using (var conn = await DataSource.OpenConnectionAsync())
            {
                rows.Add(new("Npgsql", "Server version", conn.PostgreSqlVersion.ToString()));

                rows.Add(new("Npgsql", "Tables", await ScalarAsync(conn,
                    "SELECT count(*) FROM information_schema.tables " +
                    "WHERE table_schema = 'public' AND table_type = 'BASE TABLE'")));

                rows.Add(new("Npgsql", "Views", await ScalarAsync(conn,
                    "SELECT count(*) FROM information_schema.views " +
                    "WHERE table_schema = 'public'")));

                // Proves a view is queryable, not just present. Returns no rows
                // against an empty database, which is the expected result now.
                rows.Add(new("Npgsql", "v_pick_result rows", await ScalarAsync(conn,
                    "SELECT count(*) FROM v_pick_result")));
            }

            // ---- EF Core: the path writes will use ----
            await using var db = await DbFactory.CreateDbContextAsync();

            rows.Add(new("EF Core", "Teams", (await db.Teams.CountAsync()).ToString()));

            var me = await db.Entrants
                             .Where(e => e.IsMe)
                             .Select(e => e.DisplayName)
                             .FirstOrDefaultAsync();

            rows.Add(new("EF Core", "My entrant", me ?? "(none)"));

            // If EF and Npgsql disagree here, they are not on the same database.
            rows.Add(new("EF Core", "Entity types mapped",
                db.Model.GetEntityTypes().Count().ToString()));

            results = rows;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static async Task<string> ScalarAsync(NpgsqlConnection conn, string sql)
    {
        await using var cmd = new NpgsqlCommand(sql, conn);
        var value = await cmd.ExecuteScalarAsync();
        return value?.ToString() ?? "(null)";
    }
}
