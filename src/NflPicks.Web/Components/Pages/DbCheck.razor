@page "/dbcheck"
@rendermode InteractiveServer
@using Npgsql
@inject IConfiguration Config

<PageTitle>DB check</PageTitle>

<h3>Database connection</h3>

<button class="btn btn-primary" @onclick="RunCheck" disabled="@busy">
    @(busy ? "Checking..." : "Run check")
</button>

@if (error is not null)
{
    <p style="color:#b00"><strong>Failed:</strong> @error</p>
}
else if (results is not null)
{
    <table class="table">
        <thead><tr><th>Check</th><th>Value</th></tr></thead>
        <tbody>
            @foreach (var r in results)
            {
                <tr><td>@r.Label</td><td>@r.Value</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private record Row(string Label, string Value);

    private List<Row>? results;
    private string? error;
    private bool busy;

    private async Task RunCheck()
    {
        busy = true;
        error = null;
        results = null;

        try
        {
            // Three questions, in order of what they rule out:
            //   1. can we connect and does Postgres answer
            //   2. did 01_schema.sql run   (tables exist)
            //   3. did 02_seed_reference.sql run  (32 teams, 1 entrant)
            // A green container answers none of these, which is why the page
            // asks all three rather than just opening a connection.
            var cs = Config.GetConnectionString("Picks")
                     ?? throw new InvalidOperationException(
                            "ConnectionStrings:Picks is not set. Check user secrets.");

            // `await using` awaits the DISPOSAL, not the initializer -- the
            // call itself needs its own await or `conn` is a ValueTask.
            await using var dataSource = NpgsqlDataSource.Create(cs);
            await using var conn = await dataSource.OpenConnectionAsync();

            var rows = new List<Row>();

            rows.Add(new("Server version", conn.PostgreSqlVersion.ToString()));

            rows.Add(new("Tables in public schema", await ScalarAsync(conn,
                "SELECT count(*) FROM information_schema.tables " +
                "WHERE table_schema = 'public' AND table_type = 'BASE TABLE'")));

            rows.Add(new("Views in public schema", await ScalarAsync(conn,
                "SELECT count(*) FROM information_schema.views " +
                "WHERE table_schema = 'public'")));

            rows.Add(new("Teams seeded", await ScalarAsync(conn,
                "SELECT count(*) FROM team")));

            rows.Add(new("My entrant row", await ScalarAsync(conn,
                "SELECT coalesce(max(display_name), '(none)') FROM entrant WHERE is_me")));

            results = rows;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static async Task<string> ScalarAsync(NpgsqlConnection conn, string sql)
    {
        await using var cmd = new NpgsqlCommand(sql, conn);
        var value = await cmd.ExecuteScalarAsync();
        return value?.ToString() ?? "(null)";
    }
}
